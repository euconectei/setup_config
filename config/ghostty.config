# Config do Ghostty versionada no setup_config (symlink criado por partials/_ghostty.sh).

# --- Aparencia ---
theme = Dracula
font-family = Fira Code
font-size = 14
font-feature = +calt
adjust-cell-height = 10%
minimum-contrast = 1.1

# --- Janela ---
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
macos-titlebar-style = tabs
background-opacity = 0.95
background-blur = true
unfocused-split-opacity = 0.85
window-save-state = always
window-colorspace = display-p3

# --- Cursor e mouse ---
cursor-style = bar
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- Comportamento ---
# Option esquerdo = Alt (atalhos no shell); o direito continua digitando acentos
macos-option-as-alt = left
confirm-close-surface = false
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# --- Quick terminal (requer permissao de Acessibilidade) ---
keybind = global:cmd+grave_accent=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-animation-duration = 0.15

# --- Splits ---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
